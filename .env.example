# Copy this file to `.env` and paste in the read-only access key you were given.
# `.env` is gitignored — never commit your real keys.
#
# These keys are READ-ONLY and scoped to the project bucket only: they can
# list and download data but cannot upload, overwrite, or delete anything.

WASABI_ACCESS_KEY=your-access-key-here
WASABI_SECRET_KEY=your-secret-key-here
WASABI_REGION=eu-west-1
WASABI_BUCKET=nffcfirstteamstudents
